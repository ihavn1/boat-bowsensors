    "z": "b0f0a1b2c3d4e5f6",
    "name": "Send Delta to SignalK",
    "path": "",
    "source": "",
    "meta": "",
    "x": 640,
    "y": 120,
    "wires": []
  },
  {
    "id": "fn-delta-0001",
    "type": "function",
    "z": "b0f0a1b2c3d4e5f6",
    "name": "To Delta Update",
    "func": "return {\n    payload: {\n        updates: [\n            {\n                source: { label: \"nodered\" },\n                values: [\n                    { path: msg.topic, value: msg.payload }\n                ]\n            }\n        ]\n    }\n};",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 120,
    "wires": [
